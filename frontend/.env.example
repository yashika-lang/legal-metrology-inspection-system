# Copy to .env.local (git-ignored) and adjust if your backend runs
# somewhere other than localhost:8080.
#
# This is the ONLY environment variable the frontend needs. It never talks
# to Google Vision, Gemini, or Supabase directly — every AI and storage
# call is made server-side by the backend, which is what SUPABASE_URL,
# GEMINI_API_KEY, GOOGLE_APPLICATION_CREDENTIALS etc. in backend/.env.example
# configure. Putting any of those in a frontend .env file would ship them
# to every visitor's browser — never do that.
VITE_API_BASE_URL=http://localhost:8080/api/v1
