# Copy this file to .env and fill in real values for local development.
# NEVER commit the real .env file — it is already git-ignored at the repo root.
# In dev/prod, these are set as real environment variables by the deploy
# platform (or CI secrets store), not read from a file.
#
# See ../SETUP.md for the full step-by-step guide to obtaining every value
# below (creating the Google Cloud project, the Gemini key, the Supabase
# project and buckets) and for how to verify each integration is actually
# working once configured.

# ---- Spring profile ----
SPRING_PROFILES_ACTIVE=local

# ---- Server ----
SERVER_PORT=8080

# ---- Database (Supabase PostgreSQL connection pooler, "Transaction" mode) ----
# Format: jdbc:postgresql://<host>:<port>/postgres
DB_URL=jdbc:postgresql://localhost:5432/legal_metrology
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ---- JWT ----
# Generate with: openssl rand -base64 64
# Must be at least 32 bytes — the backend refuses to start otherwise (see
# JwtTokenProvider's startup check).
JWT_SECRET=replace-with-a-256-bit-random-secret-never-commit-this
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
JWT_ISSUER=legal-metrology-inspection-system

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Password reset ----
PASSWORD_RESET_TOKEN_EXPIRATION_MS=3600000

# ---- File upload limits ----
MAX_UPLOAD_FILE_SIZE=15MB
MAX_UPLOAD_REQUEST_SIZE=30MB

# =====================================================================
# Supabase — PostgreSQL is configured above via DB_URL/DB_USERNAME/
# DB_PASSWORD (Supabase gives you these on the project's Database settings
# page). The variables below are Storage + the project's own API
# credentials, copied from Project Settings -> API.
#
# Supabase's dashboard now labels these "Publishable key" and "Secret
# key" (newer terminology replacing "anon key" / "service_role key" —
# same two credentials, same purpose, just renamed). Whichever label your
# dashboard shows, they map onto these two variables the same way:
#   Publishable key / anon key      -> SUPABASE_ANON_KEY
#   Secret key / service_role key   -> SUPABASE_SERVICE_ROLE_KEY
# =====================================================================
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key. This backend does not call Supabase Auth or read
# this key anywhere today (auth is this backend's own JWT system — see
# docs/ARCHITECTURE.md's Phase 1 decision log for why) — kept here because
# it's one of the credentials every Supabase project hands you together,
# and a future client-side Supabase integration would need it. Safe to
# leave as a placeholder; nothing breaks if it's wrong.
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# Secret / service_role key — secret, server-side only, never ship this to
# a frontend. This is the one Storage actually authenticates with.
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret-or-service-role-key

# Buckets — create these exact names in Supabase Storage (Storage -> New
# bucket) before uploading anything; the backend does not auto-create
# them. Only the first three (images/reports/evidence) are used by any
# feature today — temp/exports/training-data are reserved for planned
# features and don't need to exist yet.
SUPABASE_BUCKET_IMAGES=inspection-images
SUPABASE_BUCKET_REPORTS=inspection-reports
SUPABASE_BUCKET_EVIDENCE=evidence
SUPABASE_BUCKET_TEMP=temp
SUPABASE_BUCKET_EXPORTS=exports
SUPABASE_BUCKET_TRAINING_DATA=training-data
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=3600

# =====================================================================
# Google Cloud Vision (OCR) — two auth paths, either is enough on its own.
# =====================================================================
AI_OCR_PROVIDER=google-vision

# Path 1 (recommended, matches SETUP.md): a service account JSON key file.
# When this is set, the backend authenticates to Vision with a real OAuth2
# bearer token instead of an API key, and GOOGLE_VISION_API_KEY below is
# ignored. Absolute path on this machine, e.g.
# /Users/you/secrets/nirikshan-vision-sa.json — never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional even with a service account — only sets the quota/billing
# project header; Vision infers it from the credentials otherwise.
GOOGLE_CLOUD_PROJECT_ID=

# Path 2 (simpler): a plain Vision API key, used only if
# GOOGLE_APPLICATION_CREDENTIALS above is not set.
GOOGLE_VISION_API_KEY=replace-with-google-vision-api-key

# Offline OCR fallback — used automatically if Vision fails or isn't
# configured, and requires a native `tesseract` install on this machine
# (`brew install tesseract tesseract-lang` on macOS). Never required for
# Vision to work; only matters if you want an offline fallback too.
TESSERACT_DATA_PATH=/usr/local/share/tessdata
TESSERACT_LANGUAGE=eng

# =====================================================================
# Google Gemini — Vision AI (multimodal label understanding) + every LLM
# capability (AI Copilot, report summaries, recommendations, officer notes).
# A single API key from https://aistudio.google.com/apikey covers all of it.
# =====================================================================
AI_VISION_PROVIDER=gemini
AI_LLM_PROVIDER=gemini

# Google periodically retires model versions — if the default below 404s
# with "no longer available", check
# https://ai.google.dev/gemini-api/docs/models for the current lineup.
# Free-tier keys can also have zero quota on "pro" models even when they
# exist; "flash" models are the ones with real free-tier quota as of this
# writing — verified live against a real key while building this feature.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional configurable alternate provider for Vision AI / LLM (set
# AI_VISION_PROVIDER=claude or AI_LLM_PROVIDER=claude to use it instead of
# Gemini for that capability).
ANTHROPIC_API_KEY=replace-with-claude-api-key-if-used
CLAUDE_MODEL=claude-opus-4-1
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# ---- Logging ----
LOG_DIR=logs
